# Auto-detect text files and normalize line endings to LF on checkout
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows command files keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files - never modify line endings
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.bmp binary
*.gif binary
*.ico binary
*.obj binary
*.glb binary
*.gltf binary
*.stl binary
*.zip binary
*.tar binary
*.gz binary
*.pdf binary
